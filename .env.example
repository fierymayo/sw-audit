SHOP_DOMAIN=soccer-wearhouse.myshopify.com
# Dev Dashboard app (current path): app's Client ID + Secret from App settings > Credentials.
# A 24h admin token is minted automatically per run (client credentials grant) and cached.
CLIENT_ID=
CLIENT_SECRET=
# Legacy admin custom app, or token from get_token.py: set this instead (wins over CLIENT_ID).
ADMIN_TOKEN=
API_VERSION=2026-07
STORE_SLUG=soccer-wearhouse
STOREFRONT=https://soccerwearhouse.com
OUT_DIR=output
SYNC_LAG_HOURS=48
